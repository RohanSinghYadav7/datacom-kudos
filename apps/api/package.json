{
  "name": "@kudos/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "cross-env DATABASE_URL=file:./test.db KUDOS_SESSION_SECRET=kudos-test-session-secret-at-least-32-chars prisma migrate deploy --schema prisma/schema.prisma && cross-env DATABASE_URL=file:./test.db KUDOS_SESSION_SECRET=kudos-test-session-secret-at-least-32-chars vitest run",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:seed:admin": "dotenv -e ../../.env -- tsx prisma/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "cross-env": "^7.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.3"
  }
}
